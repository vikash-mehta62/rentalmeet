PORT=5000
NODE_ENV=development

# MongoDB Local
MONGODB_URI=mongodb://localhost:27017/rentalmeet

# JWT
JWT_SECRET=rentalmeet_super_secret_jwt_key_2026_production_ready
JWT_EXPIRE=7d

# Storage (uploads go to AWS S3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_bucket_name
AWS_S3_PUBLIC_PREFIX=public
AWS_S3_PUBLIC_BASE_URL=https://your_bucket_name.s3.ap-south-1.amazonaws.com
AWS_S3_CACHE_CONTROL=public, max-age=31536000, immutable

# Email (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@rentalmeet.com
SMTP_PASSWORD=your_hostinger_email_password
SMTP_FROM=noreply@rentalmeet.com

# Encryption (32 characters)
ENCRYPTION_KEY=rentalmeet2026encryptionkey123

# Commission
DEFAULT_COMMISSION_RATE=15

# Confirmation deadline timezone offset in minutes (IST = 330)
CONFIRMATION_TIMEZONE_OFFSET_MINUTES=330

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
